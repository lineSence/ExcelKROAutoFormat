# Настройки приложения. Код не правится, все значения берутся отсюда.

# --- веб-слой ---
# Служба слушает только локальный адрес. Доступ через SSH-туннель.
# Эти же значения подставляются в команду запуска в deploy/app.service.
APP_HOST=127.0.0.1
APP_PORT=8000

# Предельный размер входного файла, МБ. Загрузка обрывается при превышении.
MAX_UPLOAD_MB=20

# Предел суммы распакованных частей архива .xlsx, МБ. Защита от zip-бомбы.
MAX_UNPACKED_MB=200

# Каталог для временных файлов. Служба пишет только в него.
TMP_DIR=/var/lib/excelkro/work

# Срок хранения результата и загруженного файла, минуты.
# Папка с истекшим сроком удаляется при следующей загрузке.
RESULT_TTL_MINUTES=60

# --- разбор файла 1С ---
# Имя рабочего листа во входном файле.
# Если лист не найден, берётся первый лист и в журнал пишется предупреждение.
SHEET_NAME=TDSheet

# Способ ремонта файла из 1С: inject (вставка пустого sharedStrings.xml).
# Значение libreoffice оставлено как запасной вариант, стили при нём меняются.
REPAIR_MODE=inject

# Источник имени склада: filename (имя входного файла) или header (шапка файла).
WAREHOUSE_SOURCE=filename

# --- поиск пересортов ---
# Порог схожести полных имён для связи позиций в одну гроздь.
RESORT_SIMILARITY_THRESHOLD=0.80

# Полоса сомнительных совпадений имён для отчёта на странице.
DOUBTFUL_MATCH_MIN=0.70
DOUBTFUL_MATCH_MAX=0.90

# Предел числа спорных пар в отчёте на странице.
DOUBTFUL_LIMIT=200

# Границы отношения цены излишка к цене недостачи для пары разных брендов.
PRICE_GATE_LOW=0.95
PRICE_GATE_HIGH=1.50

# Ниже этой оценки пара не считается пересортом.
MATCH_MIN_SCORE=1.10

# Разрешить только чёткие пересорты: бренд с брендом, цена не учитывается.
STRICT_RESORT=false

# Слова типа товара. Удаляются в начале имени при нормализации.
TYPE_WORDS=сигареты,стики,сигариллы,табак,жидкость,картриджи,устройство,зажигалки,спички

# --- отчёты ---
# Показывать состав каждой грозди в отчёте по группам.
REPORT_CLUSTER_MEMBERS=true

# --- логи ---
# Уровень логов. Содержимое файлов в логи не пишется.
LOG_LEVEL=INFO
