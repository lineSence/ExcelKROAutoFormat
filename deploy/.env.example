# Админские настройки службы (`[CFG-TWO-LAYERS]`).
# Пользовательские настройки — пороги, режимы проверки, ключи моделей,
# почта — задаются только в интерфейсе и хранятся в runtime.json
# (`[CFG-UI-FIRST]`). Значения ниже совпадают с дефолтами app/config.py:
# при расхождении истина — код (`[ENV-SYNC]`).

# --- веб-слой ---
# По умолчанию служба слушает только локальный адрес. Для доступа по LAN/WAN
# задайте внешний APP_HOST. Доступ требуется всегда, кроме /health
# (`[SEC-AUTH-ALWAYS]`), поэтому WEB_AUTH_USER/PASSWORD заполняются всегда.
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_AUTH_USER=
WEB_AUTH_PASSWORD=

# Токен компаньона для /api/companion/* (`[SEC-COMPANION-TOKEN]`).
COMPANION_TOKEN=

# Предельный размер входного файла, МБ. Загрузка обрывается при превышении.
MAX_UPLOAD_MB=20

# Предел суммы распакованных частей архива .xlsx, МБ. Защита от zip-бомбы.
MAX_UNPACKED_MB=200

# Каталог для временных файлов. Служба пишет только в него.
TMP_DIR=/tmp/excelkro

# Срок хранения результата и загруженного файла, минуты.
RESULT_TTL_MINUTES=60

# --- разбор файла 1С ---
SHEET_NAME=TDSheet
REPAIR_MODE=inject
WAREHOUSE_SOURCE=filename

# --- поиск пересортов ---
RESORT_SIMILARITY_THRESHOLD=0.80
DOUBTFUL_MATCH_MIN=0.70
DOUBTFUL_MATCH_MAX=0.90
DOUBTFUL_LIMIT=200
PRICE_GATE_LOW=0.95
PRICE_GATE_HIGH=1.50
MATCH_MIN_SCORE=1.10
STRICT_RESORT=false
TYPE_WORDS=сигареты,стики,сигариллы,табак,жидкость,картриджи,устройство,зажигалки,спички

# --- справочники ---
REFS_DIR=/var/lib/excelkro/refs
REFS_STATE_PATH=/var/lib/excelkro/refs/state.json
DEFAULT_CHECKER=Разумовский
REFS_MATCH_MIN_SCORE=0.80
REFS_DAYS_AROUND=3
REFS_CONFIRM_MIN_SCORE=0.95
# Ячейки шапки — по дефолтам app/config.py от 15.09.2026.
REFS_CELL_REASON=C6
REFS_CELL_ADMIN=L3
REFS_CELL_CHECKER=
REFS_CELL_AUDITORS=L5
REFS_TICK_SECONDS=30

# --- отчёты ---
REPORT_CLUSTER_MEMBERS=true

# --- логи ---
LOG_LEVEL=INFO
