[Unit]
Description=ExcelKROAutoFormat (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/excelkro
EnvironmentFile=/opt/excelkro/.env
ExecStart=/opt/excelkro/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
